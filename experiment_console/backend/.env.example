# Copy this file to .env and fill in your values
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/log_analysis_dashboard?retryWrites=true&w=majority
PORT=6000

# Internal Docker service URLs (leave as-is when running inside docker-compose)
AUTH_SERVICE_URL=http://auth-service:5002
ORDER_SERVICE_URL=http://order-service:5002
PAYMENT_SERVICE_URL=http://payment-service:5002
